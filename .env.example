# Endereço do robô (Raspberry Pi)
SERVER_HOST=192.168.0.10
SERVER_PORT=5001

# Joystick
JOYSTICK_INDEX=0
# Quanto o analógico precisa se mover (0 a 1) para acionar um comando
AXIS_THRESHOLD=0.4
# Intervalo de reenvio do estado; mantém o watchdog do servidor satisfeito
HEARTBEAT_S=0.25

# Mapeamento (gerado pela tela de configuração: python main.py --configure)
# Formatos: button:<n> | axis:<n>:+ | axis:<n>:- | axis:<n>
JOYSTICK_FORWARD=
JOYSTICK_BACKWARD=
JOYSTICK_LEFT=
JOYSTICK_RIGHT=
JOYSTICK_CAMERA_V=
JOYSTICK_CAMERA_H=

# Teclado (funciona com a janela "Controle do robô" em foco; Esc sai)
KEYBOARD_ENABLED=true
# Nomes de tecla do pygame separados por vírgula (ex.: w, up, space, left shift)
KEY_FORWARD=w
KEY_BACKWARD=s
KEY_LEFT=a
KEY_RIGHT=d
KEY_CAMERA_UP=up
KEY_CAMERA_DOWN=down
KEY_CAMERA_LEFT=left
KEY_CAMERA_RIGHT=right

# Vídeo (exibido dentro da janela "Controle do robô")
VIDEO_ENABLED=false
# URL do stream (ex.: http://192.168.0.10:8081/) ou índice de webcam local (0)
STREAMING_URL=
# Tamanho da janela; o vídeo é ajustado mantendo a proporção
VIDEO_SIZE=800x600
VIDEO_ROTATE_180=true
FACE_DETECTION=false
